---
import { ClientRouter } from 'astro:transitions'

interface Props {
  title?: string
  description?: string
  socialImage?: string
  ogType?: 'website' | 'article'
}
const {
  title = 'Now We Try It My Way',
  description = 'A personal cookbook.',
  socialImage,
  ogType = 'website',
} = Astro.props
const canonicalUrl = new URL(Astro.url.pathname, Astro.site).toString()
const socialImageUrl = socialImage
  ? new URL(socialImage, Astro.site).toString()
  : new URL('/favicon.ico', Astro.site).toString()
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
    <link rel="icon" href="/favicon.ico" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="theme-color" content="#0D5277" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" type="application/rss+xml" title="Now We Try It My Way" href="/rss.xml" />
    <meta property="og:site_name" content="Now We Try It My Way" />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={socialImageUrl} />
    <meta name="twitter:card" content={socialImage ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageUrl} />
    <title>{title}</title>
    <slot name="head" />
    <ClientRouter />
  </head>
  <body>
    <slot />
    <footer class="site-footer no-print">
      <p>
        <span>&copy; {new Date().getFullYear()} <a href="https://goblindegook.com">Luís Rodrigues</a></span>
        <button
          id="wake-lock-btn"
          class="wake-lock-btn"
          aria-label="Keep screen awake"
          aria-pressed="false"
          hidden
        >
          <span data-eye="open" aria-hidden="true">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10 12a2 2 0 1 0 4 0a2 2 0 0 0 -4 0"/><path d="M21 12c-2.4 4 -5.4 6 -9 6c-3.6 0 -6.6 -2 -9 -6c2.4 -4 5.4 -6 9 -6c3.6 0 6.6 2 9 6"/></svg>
          </span>
          <span data-eye="slash" aria-hidden="true">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10.585 10.587a2 2 0 0 0 2.829 2.828"/><path d="M16.681 16.673a8.717 8.717 0 0 1 -4.681 1.327c-3.6 0 -6.6 -2 -9 -6c1.272 -2.12 2.712 -3.678 4.32 -4.674m2.86 -1.146a9.055 9.055 0 0 1 1.82 -.18c3.6 0 6.6 2 9 6c-.666 1.11 -1.379 2.067 -2.138 2.87"/><path d="M3 3l18 18"/></svg>
          </span>
          <span class="wake-lock-btn__label">Keep screen on</span>
        </button>
      </p>
    </footer>
    <timer-dock transition:persist></timer-dock>
    <script>
      import '../web-components/timer-dock';

      if ('serviceWorker' in navigator) {
        window.addEventListener('load', () => {
          navigator.serviceWorker.register('/sw.js').catch((err) => {
            console.error('Service worker registration failed', err)
          })
        })
      }
    </script>
    <script>
      const STORAGE_KEY = 'cookbook-wake-lock'
      const TTL = 86_400_000

      // biome-ignore lint/suspicious/noExplicitAny: Wake Lock API is optional and may be undefined
      const wakeLockApi = (navigator as any).wakeLock as WakeLock | undefined

      let sentinel: WakeLockSentinel | null = null
      let acquiring = false
      let enabled = false

      document.addEventListener('astro:page-load', init)
      document.addEventListener('visibilitychange', () => {
        if (!document.hidden && enabled) void acquire()
      })

      function init() {
        const btn = document.getElementById('wake-lock-btn') as HTMLButtonElement | null
        if (!btn || !wakeLockApi) return
        btn.hidden = false
        enabled = readState()
        setPressed(enabled)
        if (enabled) void acquire()
        btn.addEventListener('click', async () => {
          enabled = !enabled
          writeState(enabled)
          setPressed(enabled)
          if (enabled) void acquire()
          else await release()
        })
      }

      function setPressed(value: boolean) {
        const btn = document.getElementById('wake-lock-btn')
        if (!btn) return
        btn.setAttribute('aria-pressed', String(value))
        const label = btn.querySelector('.wake-lock-btn__label')
        if (label) label.textContent = value ? 'Keeping screen on' : 'Keep screen on'
      }

      function readState(): boolean {
        try {
          const raw = localStorage.getItem(STORAGE_KEY)
          if (!raw) return false
          const parsed = JSON.parse(raw) as { enabled: boolean; expiresAt: number }
          if (!parsed.enabled || Date.now() > parsed.expiresAt) {
            localStorage.removeItem(STORAGE_KEY)
            return false
          }
          return true
        } catch {
          return false
        }
      }

      function writeState(on: boolean) {
        try {
          if (on) {
            localStorage.setItem(
              STORAGE_KEY,
              JSON.stringify({ enabled: true, expiresAt: Date.now() + TTL }),
            )
          } else {
            localStorage.removeItem(STORAGE_KEY)
          }
        } catch {}
      }

      async function acquire() {
        if (sentinel || acquiring || document.hidden) return
        acquiring = true
        try {
          sentinel = await wakeLockApi!.request('screen')
          sentinel.addEventListener('release', onRelease)
        } catch {
          // Acquisition can fail transiently on page load before the document is
          // fully active. Keep enabled state intact — visibilitychange will retry.
        }
        acquiring = false
      }

      async function release() {
        if (!sentinel) return
        const s = sentinel
        sentinel = null
        s.removeEventListener('release', onRelease)
        try {
          if (!s.released) await s.release()
        } catch {}
      }

      function onRelease() {
        sentinel = null
        if (enabled) void acquire()
      }
    </script>
  </body>
</html>

<style is:global>
  @font-face {
    font-family: 'Inter';
    src: url('/fonts/inter/inter-regular-400.woff2') format('woff2');
    font-style: normal;
    font-weight: 400;
    font-display: swap;
  }

  @font-face {
    font-family: 'Inter';
    src: url('/fonts/inter/inter-600.woff2') format('woff2');
    font-style: normal;
    font-weight: 600;
    font-display: swap;
  }

  @font-face {
    font-family: 'Inter';
    src: url('/fonts/inter/inter-italic-400.woff2') format('woff2');
    font-style: italic;
    font-weight: 400;
    font-display: swap;
  }

  @font-face {
    font-family: 'Playfair Display';
    src: url('/fonts/playfair-display/playfair-regular-400.woff2') format('woff2');
    font-style: normal;
    font-weight: 400;
    font-display: swap;
  }

  @font-face {
    font-family: 'Playfair Display';
    src: url('/fonts/playfair-display/playfair-600.woff2') format('woff2');
    font-style: normal;
    font-weight: 600;
    font-display: swap;
  }

  @font-face {
    font-family: 'Playfair Display';
    src: url('/fonts/playfair-display/playfair-italic-400.woff2') format('woff2');
    font-style: italic;
    font-weight: 400;
    font-display: swap;
  }

  :root {
    --color-canvas: #faf9f7;
    --color-surface: #fffefb;
    --color-ink: #1c1c1c;
    --color-subtle: #6b6460;
    --color-disabled: #cdbbb0;
    --color-edge: #e5dfd6;
    --color-interactive: #BB330C;
    --color-accent: #FFAC3F;
    --color-highlight: #2D6887;
    --color-chrome-bg: #0D5277;
    --color-chrome-fg: rgba(255, 255, 255, 0.7);
    --color-void: #1e1a17;
    --color-positive: oklch(47% 0.1 152);
    --color-tint: rgba(249, 221, 148, 0.3);
    --font-serif: 'Playfair Display', Georgia, serif;
    --font-sans: 'Inter', system-ui, sans-serif;
    --max-width: 1200px;
    --max-prose: 720px;
  }

  *, *::before, *::after { box-sizing: border-box; }
  [hidden] { display: none !important; }

  html {
    font-size: 16px;
    -webkit-font-smoothing: antialiased;
  }

  body {
    margin: 0;
    background: var(--color-canvas);
    color: var(--color-ink);
    font-family: var(--font-sans);
    line-height: 1.6;
  }

  img { display: block; max-width: 100%; }

  a {
    color: inherit;
    text-decoration: none;
  }

  :focus-visible {
    outline: 2px solid var(--color-interactive);
    outline-offset: 3px;
    border-radius: 2px;
  }

  h1, h2, h3 {
    font-family: var(--font-serif);
    line-height: 1.2;
    font-weight: 400;
    text-wrap: balance;
  }

  p {
    text-wrap: pretty;
  }

  .site-footer {
    border-top: 1px solid var(--color-edge);
    font-size: 0.8125rem;
    color: var(--color-subtle);
  }
  .site-footer p {
    margin: 0 auto;
    max-width: var(--max-width);
    padding: 1.5rem 1.5rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .site-footer a {
    color: var(--color-subtle);
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .site-footer a:hover { color: var(--color-interactive); }

  .wake-lock-btn {
    background: none;
    border: none;
    cursor: pointer;
    font: inherit;
    padding: 0.375rem 0.5rem;
    margin: -0.375rem -0.5rem;
    min-height: 2.5rem;
    color: var(--color-subtle);
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    transition: color 0.15s;
  }
  .wake-lock-btn:hover { color: var(--color-ink); }
  .wake-lock-btn[aria-pressed="true"] { color: var(--color-accent); }
  .wake-lock-btn [data-eye] { display: inline-flex; align-items: center; }
  .wake-lock-btn [data-eye="open"] { display: none; }
  .wake-lock-btn[aria-pressed="true"] [data-eye="open"] { display: inline-flex; align-items: center; }
  .wake-lock-btn[aria-pressed="true"] [data-eye="slash"] { display: none; }

  @media print {
    .no-print { display: none !important; }
  }
</style>
