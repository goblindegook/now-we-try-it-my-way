---
interface Props {
  title?: string
  description?: string
}
const { title = 'Now We Try It My Way', description = 'A personal cookbook.' } = Astro.props
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;1,400&family=Inter:ital,wght@0,400;0,500;0,600;1,400&display=swap" rel="stylesheet" />
  </head>
  <body>
    <slot />
    <footer class="site-footer no-print">
      <p>&copy; 2026 <a href="https://goblindegook.com">Luís Rodrigues</a></p>
    </footer>
    <timer-dock></timer-dock>
    <script>
      import '../web-components/timer-dock';
    </script>
  </body>
</html>

<style is:global>
  :root {
    --color-bg: #faf9f7;
    --color-surface: #fffefb;
    --color-text: #1c1c1c;
    --color-muted: #6b6460;
    --color-border: #e5dfd6;
    --color-accent: #b85c38;
    --color-accent-hover: #9a4a2c;
    --color-success: #4a7c59;
    --color-ingredient: rgba(184, 92, 56, 0.07);
    --font-serif: 'Playfair Display', Georgia, serif;
    --font-sans: 'Inter', system-ui, sans-serif;
    --max-width: 1200px;
    --max-prose: 720px;
  }

  *, *::before, *::after { box-sizing: border-box; }

  html {
    font-size: 16px;
    -webkit-font-smoothing: antialiased;
  }

  body {
    margin: 0;
    background: var(--color-bg);
    color: var(--color-text);
    font-family: var(--font-sans);
    line-height: 1.6;
  }

  img { display: block; max-width: 100%; }

  a {
    color: inherit;
    text-decoration: none;
  }

  :focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 3px;
    border-radius: 2px;
  }

  h1, h2, h3 {
    font-family: var(--font-serif);
    line-height: 1.2;
  }

  .site-footer {
    border-top: 1px solid var(--color-border);
    text-align: center;
    padding: 1.5rem 1.5rem;
    font-size: 0.8125rem;
    color: var(--color-muted);
  }
  .site-footer p { margin: 0; }
  .site-footer a {
    color: var(--color-muted);
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .site-footer a:hover { color: var(--color-accent); }

  @media print {
    .no-print { display: none !important; }
  }
</style>
