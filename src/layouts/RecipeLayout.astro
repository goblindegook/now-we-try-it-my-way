---
import { Image } from 'astro:assets'
import Navigation from '../components/Navigation.astro'
import type { ParsedRecipe } from '../lib/cooklang'
import { cuisineToFlag } from '../lib/cuisine'
import { resolveRecipePhoto } from '../lib/recipe-images'
import '../styles/hero.css'
import Layout from './Layout.astro'

interface Props {
  recipe?: ParsedRecipe
  categories: string[]
  recipeSchemaJson?: string
  socialImage?: string
}
const { recipe, categories, recipeSchemaJson = '', socialImage } = Astro.props
const recipePhoto = resolveRecipePhoto(recipe?.photo, recipe?.category, recipe?.slug)
const cuisineFlag = cuisineToFlag(recipe?.cuisine ?? '')
---

<Layout
  title={`${recipe?.title} — Now We Try It My Way`}
  description={recipe?.description}
  socialImage={socialImage}
  ogType="article"
>
  {recipeSchemaJson && (
    <script
      slot="head"
      type="application/ld+json"
      data-schema="recipe"
      set:html={recipeSchemaJson}
    />
  )}
  <Navigation categories={categories} current={recipe?.category} />

  <article class="h-recipe">
  <div class:list={['hero', { 'hero--no-photo': !recipePhoto }]}>
    {recipePhoto
      ? <Image src={recipePhoto} alt={recipe?.title ?? ''} class="hero__img u-photo" />
      : <div class="hero__placeholder" />
    }
    <div class="hero__overlay">
      <div class="hero__overlay-content">
        <div class="hero__meta p-category">{recipe?.category}</div>
        <h1 class="hero__title p-name">{recipe?.title}</h1>
        {recipe?.description && <p class="p-summary" hidden>{recipe.description}</p>}
        <div class="hero__times">
          {cuisineFlag && <span class="hero__cuisine-flag">{cuisineFlag}</span>}
          {recipe?.prepTime && <time class="dt-prep-time" datetime={recipe.prepTime}>Prep: {recipe.prepTime}</time>}
          {recipe?.cookTime && <time class="dt-cook-time" datetime={recipe.cookTime}>Cook: {recipe.cookTime}</time>}
        </div>
      </div>
    </div>
  </div>

  <main class="recipe-body">
    {recipe?.description && <p class="recipe-description">{recipe.description}</p>}

    <aside class="recipe-sidebar">
      <h2 class="recipe-sidebar__title">Ingredients</h2>
      <slot name="sidebar" />
    </aside>

    <div class="recipe-steps">
      <slot />
    </div>
  </main>
  </article>

  <script>
    import '../web-components/step-timer';
  </script>
</Layout>

<style>
  .hero__times {
    display: flex;
    gap: 0;
    font-size: 0.9375rem;
    color: rgba(255,255,255,0.85);
  }
  .hero__times time + time::before,
  .hero__times .hero__cuisine-flag + time::before {
    content: '·';
    margin: 0 0.625rem;
  }
  .tag-chip {
    display: inline-block;
    margin-left: 0.5rem;
    font-size: 0.75rem;
    line-height: 1;
    padding: 0.35rem 0.5rem;
    border: 1px solid rgba(255, 255, 255, 0.45);
    border-radius: 999px;
    color: rgba(255, 255, 255, 0.92);
    text-transform: lowercase;
  }
  .tag-chip:hover {
    border-color: rgba(255, 255, 255, 0.75);
    color: #fff;
  }
  .recipe-body {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 4rem 1.5rem 4rem;
    display: grid;
    grid-template-columns: 280px 1fr;
    grid-template-rows: auto 1fr;
    grid-template-areas:
      "ingredients description"
      "ingredients steps";
    column-gap: 5rem;
    align-items: start;
  }

  .recipe-description {
    grid-area: description;
    font-size: 1.0625rem;
    color: var(--color-subtle);
    margin: 0;
    padding: 0 0 2rem;
    font-style: italic;
  }
  .recipe-sidebar {
    grid-area: ingredients;
  }
  .recipe-sidebar__title {
    font-family: var(--font-serif);
    font-size: 1.5rem;
    font-weight: 400;
    color: var(--color-ink);
    margin: 0;
    padding: 0 0 1rem;
  }
  .recipe-steps {
    grid-area: steps;
  }
  @media (max-width: 700px) {
    .recipe-body {
      grid-template-columns: 1fr;
      grid-template-areas:
        "description"
        "ingredients"
        "steps";
      column-gap: 0;
      row-gap: 2rem;
    }
  }
  @media print {
    .hero__times {
      display: none;
    }
    .recipe-body { display: block; }
  }
</style>
