---
import Navigation from '../components/Navigation.astro'
import { type Category, sortCategories } from '../lib/categories'
import { loadAllRecipes } from '../lib/cooklang'
import Layout from './Layout.astro'

interface Props {
  frontmatter: { title: string; description?: string }
}
const { title, description } = Astro.props.frontmatter

const recipes = await loadAllRecipes()
const categories = sortCategories([...new Set(recipes.map((r) => r.category as Category))])
---

<Layout title={`${title} — Now We Try It My Way`} description={description}>
  <Navigation categories={categories} />
  <main class="prose">
    <slot />
  </main>
</Layout>

<style is:global>
  .prose {
    max-width: var(--max-prose);
    margin: 0 auto;
    padding: 3rem 1.5rem 5rem;
  }

  .prose h1 {
    font-size: clamp(2.5rem, 6vw, 3.5rem);
    font-style: italic;
    margin: 0 0 2rem;
  }

  .prose h2 {
    font-size: clamp(1.5rem, 3vw, 2rem);
    margin: 3rem 0 1rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--color-edge);
  }

  .prose h3 {
    font-size: 1.25rem;
    margin: 2rem 0 0.5rem;
  }

  .prose p {
    margin: 0 0 1rem;
  }

  .prose a {
    color: var(--color-interactive);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
</style>
