---
import CategoryNav from '../../components/CategoryNav.astro'
import Layout from '../../layouts/Layout.astro'
import { sortCategories } from '../../lib/categories'
import { getAllTags, loadAllRecipes } from '../../lib/cooklang'
import { pluralize } from '../../lib/pluralize'

const recipes = await loadAllRecipes()
const categories = sortCategories([...new Set(recipes.map((r) => r.category))])
const tags = getAllTags(recipes)
---

<Layout title="Tags — Now We Try It My Way">
  <CategoryNav categories={categories} />
  <main class="listing">
    <div class="listing__header">
      <h1>Tags</h1>
      <p>{tags.length} tags</p>
    </div>
    <ul class="tags-list">
      {tags.map(({ tag, count }) => (
        <li>
          <a href={`/tags/${tag}`} class="tags-list__link">
            <span>{tag}</span>
            <span>{pluralize(count, 'recipe')}</span>
          </a>
        </li>
      ))}
    </ul>
  </main>
</Layout>

<style>
  .listing {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 3rem 1.5rem 4rem;
  }
  .listing__header {
    margin-bottom: 2rem;
    border-bottom: 1px solid var(--color-border);
    padding-bottom: 1.5rem;
  }
  .listing__header h1 {
    font-size: clamp(2.25rem, 4.5vw, 3.5rem);
    margin: 0 0 0.375rem;
    line-height: 1.1;
  }
  .listing__header p {
    color: var(--color-muted);
    font-size: 0.8125rem;
    margin: 0;
  }
  .tags-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.5rem;
  }
  .tags-list__link {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.875rem 1rem;
    border: 1px solid var(--color-border);
    border-radius: 8px;
    text-transform: lowercase;
  }
  .tags-list__link:hover {
    border-color: var(--color-accent);
  }
</style>
