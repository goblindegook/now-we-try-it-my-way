---
import Navigation from '../components/Navigation.astro'
import RecipeCard from '../components/RecipeCard.astro'
import Layout from '../layouts/Layout.astro'
import { type Category, sortCategories } from '../lib/categories'
import { loadAllRecipes, sortRecipesByRecency } from '../lib/cooklang'
import { pluralize } from '../lib/pluralize'

const recipes = await loadAllRecipes()
const recentRecipes = sortRecipesByRecency([...recipes])
const categories = sortCategories([...new Set(recipes.map((r) => r.category as Category))])

const latest = recentRecipes.slice(0, 3)

const byCategory = categories.map((cat) => ({
  name: cat,
  recent: recentRecipes.find((r) => r.category === cat),
  total: recipes.filter((r) => r.category === cat).length,
}))
---

<Layout title="Now We Try It My Way" description="A personal recipe collection.">
  <Navigation categories={categories} />

  <main>
    <section class="hero">
      <div class="hero__inner">
        <h1 class="hero__title">Let’s skip the life story.</h1>
        <p class="hero__sub">Made for myself, not search engines.</p>
      </div>
    </section>

    <div class="content">
      <section class="section">
        <div class="section__titlebar">
          <h2 class="section__heading">Latest recipes</h2>
          <a href="/recipes" class="section__viewall">Browse all recipes →</a>
        </div>
        <div class="grid">
          {latest.map((recipe) => <RecipeCard recipe={recipe} />)}
        </div>
      </section>

      <section class="section">
        <h2 class="section__heading">By category</h2>
        <div class="categories">
          {byCategory.map(({ name, recent, total }) => (
            <div class="cat">
              <div class="cat__header">
                <a href={`/${name.toLowerCase()}`} class="cat__name">{name}</a>
                <span class="cat__count">{pluralize(total, 'recipe')}</span>
              </div>
              {recent && <RecipeCard recipe={recent} />}
              <a href={`/${name.toLowerCase()}`} class="cat__browse">Browse all {name.toLowerCase()} →</a>
            </div>
          ))}
        </div>
      </section>
    </div>
  </main>
</Layout>

<style>
  .hero {
    background: var(--color-accent);
    padding: 5rem 1.5rem 4rem;
    text-align: center;
  }
  .hero__inner {
    max-width: var(--max-prose);
    margin: 0 auto;
  }
  .hero__title {
    font-family: var(--font-serif);
    font-size: clamp(2.5rem, 6vw, 4.5rem);
    margin: 0 0 0.75rem;
    color: var(--color-interactive);
    line-height: 1.1;
    text-wrap: balance;
  }
  .hero__sub {
    font-size: 1.125rem;
    color: var(--color-ink);
    margin: 0;
  }
  .content {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 3rem 1.5rem 5rem;
  }

  .section {
    margin-bottom: 4rem;
  }
  .section__titlebar {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 2rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--color-edge);
  }
  .section__heading {
    font-family: var(--font-serif);
    font-size: clamp(1.5rem, 3vw, 2rem);
    margin: 0 0 2rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--color-edge);
  }
  .section__titlebar .section__heading {
    margin: 0;
    padding-bottom: 0;
    border-bottom: none;
  }
  .section__viewall {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-interactive);
    white-space: nowrap;
    flex-shrink: 0;
  }
  .section__viewall:hover { color: var(--color-interactive); }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 1.75rem;
  }

  .categories {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 2.5rem;
  }
  .cat__header {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    margin-bottom: 1rem;
  }
  .cat__name {
    font-family: var(--font-serif);
    font-size: 1.375rem;
    font-weight: 600;
    color: var(--color-ink);
  }
  .cat__name:hover { color: var(--color-interactive); }
  .cat__count {
    font-size: 0.75rem;
    color: var(--color-subtle);
    font-weight: 400;
  }
  .cat__browse {
    display: inline-block;
    margin-top: 0.875rem;
    font-size: 0.875rem;
    color: var(--color-interactive);
    font-weight: 600;
  }
  .cat__browse:hover { color: var(--color-interactive); }
</style>
