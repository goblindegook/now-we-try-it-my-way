---
import { getImage } from 'astro:assets'
import Navigation from '../../../components/Navigation.astro'
import RecipeCard from '../../../components/RecipeCard.astro'
import RecipePagination from '../../../components/RecipePagination.astro'
import Layout from '../../../layouts/Layout.astro'
import { type Category, sortCategories } from '../../../lib/categories'
import { loadAllRecipes } from '../../../lib/cooklang'
import { pluralize } from '../../../lib/pluralize'
import { resolveRecipePhoto } from '../../../lib/recipe-images'
import { paginateRecipes } from '../../../lib/recipes-pagination'
import { buildSearchIndex } from '../../../lib/search'

export async function getStaticPaths() {
  const recipes = await loadAllRecipes()
  const categories = [...new Set(recipes.map((r) => r.category))]

  return categories.flatMap((category) => {
    const categoryRecipes = recipes.filter((r) => r.category === category)
    const { totalPages } = paginateRecipes(categoryRecipes, 1)

    return Array.from({ length: Math.max(totalPages - 1, 0) }, (_, index) => ({
      params: {
        category: category.toLowerCase(),
        page: String(index + 2),
      },
      props: {
        category,
        recipes: categoryRecipes,
      },
    }))
  })
}

const { category, recipes } = Astro.props
const currentPage = Number(Astro.params.page ?? '1')
const allRecipes = await loadAllRecipes()
const categories = sortCategories([...new Set(allRecipes.map((r) => r.category as Category))])
const { pageItems: visibleRecipes, totalPages } = paginateRecipes(recipes, currentPage)

const searchIndex = await buildSearchIndex(recipes, async (recipe) => {
  const photo = resolveRecipePhoto(recipe.photo, recipe.category)
  const processed = photo ? await getImage({ src: photo }) : null
  return processed?.src ?? null
})
const searchIndexJson = JSON.stringify(searchIndex.index)
---

<Layout title={`${category} — Page ${currentPage} — Now We Try It My Way`}>
  <Navigation categories={categories} current={category} />
  <main class="listing">
    <div class="listing__header">
      <h1>{category}</h1>
      <p>{pluralize(recipes.length, 'recipe')}</p>
    </div>
    <recipe-search target="recipes-static-content"></recipe-search>
    <div id="recipes-static-content">
      <div class="grid">
        {visibleRecipes.map(recipe => <RecipeCard recipe={recipe} />)}
      </div>
      <RecipePagination currentPage={currentPage} totalPages={totalPages} basePath={`/${String(category).toLowerCase()}`} />
    </div>
  </main>
</Layout>

<script is:inline define:vars={{ searchIndexJson }}>
  window.__SEARCH_INDEX__ = JSON.parse(searchIndexJson)
</script>

<script>
  import '../../../web-components/recipe-search'
</script>

<style>
  .listing {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 3rem 1.5rem 4rem;
  }
  .listing__header {
    margin-bottom: 3rem;
    border-bottom: 1px solid var(--color-edge);
    padding-bottom: 1.5rem;
  }
  .listing__header h1 {
    font-size: clamp(2.25rem, 4.5vw, 3.5rem);
    margin: 0 0 0.375rem;
    line-height: 1.1;
  }
  .listing__header p {
    color: var(--color-subtle);
    font-size: 0.8125rem;
    margin: 0;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 1.75rem;
  }
</style>
