---
import { getImage } from 'astro:assets'
import Navigation from '../../../components/Navigation.astro'
import RecipeListing from '../../../components/RecipeListing.astro'
import Layout from '../../../layouts/Layout.astro'
import { type Category, sortCategories } from '../../../lib/categories'
import { loadAllRecipes } from '../../../lib/cooklang'
import { resolveRecipePhoto } from '../../../lib/recipe-images'
import { paginateRecipes } from '../../../lib/recipes-pagination'
import { buildSearchIndex } from '../../../lib/search'

export async function getStaticPaths() {
  const recipes = await loadAllRecipes()
  const categories = [...new Set(recipes.map((r) => r.category))]

  return categories.flatMap((category) => {
    const categoryRecipes = recipes.filter((r) => r.category === category)
    const { totalPages } = paginateRecipes(categoryRecipes, 1)

    return Array.from({ length: Math.max(totalPages - 1, 0) }, (_, index) => ({
      params: {
        category: category.toLowerCase(),
        page: String(index + 2),
      },
      props: {
        category,
        recipes: categoryRecipes,
      },
    }))
  })
}

const { category, recipes } = Astro.props
const currentPage = Number(Astro.params.page ?? '1')
const allRecipes = await loadAllRecipes()
const categories = sortCategories([...new Set(allRecipes.map((r) => r.category as Category))])
const { pageItems: visibleRecipes, totalPages } = paginateRecipes(recipes, currentPage)

const searchIndex = await buildSearchIndex(recipes, async (recipe) => {
  const photo = resolveRecipePhoto(recipe.photo, recipe.category, recipe.slug)
  const processed = photo ? await getImage({ src: photo }) : null
  return processed?.src ?? null
})
const searchIndexJson = JSON.stringify(searchIndex.index)
---

<Layout title={`${category} — Page ${currentPage} — Now We Try It My Way`}>
  <Navigation categories={categories} current={category} />
  <RecipeListing
    heading={category}
    visibleRecipes={visibleRecipes}
    currentPage={currentPage}
    totalPages={totalPages}
    basePath={`/${String(category).toLowerCase()}`}
    searchIndex={searchIndexJson}
  />
</Layout>
