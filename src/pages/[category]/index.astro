---
import CategoryNav from '../../components/CategoryNav.astro'
import RecipeCard from '../../components/RecipeCard.astro'
import Layout from '../../layouts/Layout.astro'
import { sortCategories } from '../../lib/categories'
import { loadAllRecipes } from '../../lib/cooklang'
import { pluralize } from '../../lib/pluralize'

export async function getStaticPaths() {
  const recipes = await loadAllRecipes()
  const categories = sortCategories([...new Set(recipes.map((r) => r.category))])
  return categories.map((category) => ({
    params: { category: category.toLowerCase() },
    props: {
      category,
      recipes: recipes.filter((r) => r.category === category),
    },
  }))
}

const { category, recipes } = Astro.props
const allRecipes = await loadAllRecipes()
const categories = sortCategories([...new Set(allRecipes.map((r) => r.category))])
---

<Layout title={`${category} — Now We Try It My Way`}>
  <CategoryNav categories={categories} current={category} />
  <main class="listing">
    <div class="listing__header">
      <h1>{category}</h1>
      <p>{pluralize(recipes.length, 'recipe')}</p>
    </div>
    <div class="grid">
      {recipes.map(recipe => <RecipeCard recipe={recipe} />)}
    </div>
  </main>
</Layout>

<style>
  .listing {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 3rem 1.5rem 4rem;
  }
  .listing__header {
    margin-bottom: 3rem;
    border-bottom: 1px solid var(--color-border);
    padding-bottom: 1.5rem;
  }
  .listing__header h1 {
    font-size: clamp(2.25rem, 4.5vw, 3.5rem);
    margin: 0 0 0.375rem;
    line-height: 1.1;
  }
  .listing__header p {
    color: var(--color-muted);
    font-size: 0.8125rem;
    margin: 0;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 1.75rem;
  }
</style>
