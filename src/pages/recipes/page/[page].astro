---
import { getImage } from 'astro:assets'
import Navigation from '../../../components/Navigation.astro'
import RecipeListing from '../../../components/RecipeListing.astro'
import Layout from '../../../layouts/Layout.astro'
import { type Category, sortCategories } from '../../../lib/categories'
import { loadAllRecipes } from '../../../lib/cooklang'
import { resolveRecipePhoto } from '../../../lib/recipe-images'
import { paginateRecipes } from '../../../lib/recipes-pagination'
import { buildSearchIndex } from '../../../lib/search'

export async function getStaticPaths() {
  const recipes = await loadAllRecipes()
  const { totalPages } = paginateRecipes(recipes, 1)

  return Array.from({ length: Math.max(totalPages - 1, 0) }, (_, index) => ({
    params: { page: String(index + 2) },
  }))
}

const recipes = await loadAllRecipes()
const currentPage = Number(Astro.params.page ?? '1')
const { pageItems: visibleRecipes, totalPages } = paginateRecipes(recipes, currentPage)
const categories = sortCategories([...new Set(recipes.map((r) => r.category as Category))])

const searchIndex = await buildSearchIndex(recipes, async (recipe) => {
  const photo = resolveRecipePhoto(recipe.photo, recipe.category)
  const processed = photo ? await getImage({ src: photo }) : null
  return processed?.src ?? null
})
const searchIndexJson = JSON.stringify(searchIndex.index)
---

<Layout title={`All Recipes — Page ${currentPage} — Now We Try It My Way`}>
  <Navigation categories={categories} />
  <RecipeListing
    heading="All Recipes"
    totalRecipes={recipes.length}
    visibleRecipes={visibleRecipes}
    currentPage={currentPage}
    totalPages={totalPages}
    searchIndex={searchIndexJson}
  />
</Layout>
