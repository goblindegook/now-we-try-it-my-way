---
import { getImage } from 'astro:assets'
import { BloomSearch } from '@pacote/bloom-search'
import Navigation from '../../../components/Navigation.astro'
import RecipeCard from '../../../components/RecipeCard.astro'
import RecipePagination from '../../../components/RecipePagination.astro'
import Layout from '../../../layouts/Layout.astro'
import { type Category, sortCategories } from '../../../lib/categories'
import { loadAllRecipes } from '../../../lib/cooklang'
import { pluralize } from '../../../lib/pluralize'
import { paginateRecipes } from '../../../lib/recipes-pagination'
import { resolveRecipePhoto } from '../../../lib/recipe-images'
import { buildConfig, toSearchDocument } from '../../../lib/search'

export async function getStaticPaths() {
  const recipes = await loadAllRecipes()
  const { totalPages } = paginateRecipes(recipes, 1)

  return Array.from({ length: Math.max(totalPages - 1, 0) }, (_, index) => ({
    params: { page: String(index + 2) },
  }))
}

const recipes = await loadAllRecipes()
const currentPage = Number(Astro.params.page ?? '1')
const { pageItems: visibleRecipes, totalPages } = paginateRecipes(recipes, currentPage)
const categories = sortCategories([...new Set(recipes.map((r) => r.category as Category))])

const bs = new BloomSearch(buildConfig)
for (const recipe of recipes) {
  const photo = resolveRecipePhoto(recipe.photo, recipe.category)
  const processed = photo ? await getImage({ src: photo }) : null
  const photoSrc = processed?.src ?? null
  bs.add(recipe.slug, toSearchDocument(recipe, photoSrc))
}
const searchIndexJson = JSON.stringify(bs.index)
---

<Layout title={`All Recipes — Page ${currentPage} — Now We Try It My Way`}>
  <Navigation categories={categories} />
  <main class="listing">
    <div class="listing__header">
      <h1>All Recipes</h1>
      <p>{pluralize(recipes.length, 'recipe')}</p>
    </div>
    <recipe-search target="recipes-grid"></recipe-search>
    <div class="grid" id="recipes-grid">
      {visibleRecipes.map(recipe => <RecipeCard recipe={recipe} />)}
    </div>
    <RecipePagination currentPage={currentPage} totalPages={totalPages} />
  </main>
</Layout>

<script is:inline define:vars={{ searchIndexJson }}>
  window.__SEARCH_INDEX__ = JSON.parse(searchIndexJson)
</script>

<script>
  import '../../../web-components/recipe-search'
</script>

<style>
  .listing {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 3rem 1.5rem 4rem;
  }
  .listing__header {
    margin-bottom: 3rem;
    border-bottom: 1px solid var(--color-edge);
    padding-bottom: 1.5rem;
  }
  .listing__header h1 {
    font-size: clamp(2.25rem, 4.5vw, 3.5rem);
    margin: 0 0 0.375rem;
    line-height: 1.1;
  }
  .listing__header p {
    color: var(--color-subtle);
    font-size: 0.8125rem;
    margin: 0;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 1.75rem;
  }
</style>
