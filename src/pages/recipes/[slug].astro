---
import { getImage } from 'astro:assets'
import { getCollection } from 'astro:content'
import type { FixedValue, Ingredient, Item, QuantityPart, Range, TimerItem } from '@tmlmt/cooklang-parser'
import { escape as escapeHtml } from 'html-escaper'
import RecipeLayout from '../../layouts/RecipeLayout.astro'
import { type Category, sortCategories } from '../../lib/categories'
import { loadAllRecipes } from '../../lib/cooklang'
import { buildIngredientSlugIndex, normalizeIngredientName } from '../../lib/ingredients'
import { resolveRecipePhoto } from '../../lib/recipe-images'

export async function getStaticPaths() {
  const recipes = await loadAllRecipes()
  return recipes.map((recipe) => ({
    params: { slug: recipe.slug },
    props: { slug: recipe.slug },
  }))
}

const { slug } = Astro.props
const allRecipes = await loadAllRecipes()
const categories = sortCategories([...new Set(allRecipes.map((r) => r.category as Category))])
const recipe = allRecipes.find((r) => r.slug === slug)
const ingredientEntries = await getCollection('ingredients')
const ingredientSlugByName = buildIngredientSlugIndex(
  ingredientEntries.map((entry) => ({ slug: entry.id, name: entry.data.name, aliases: entry.data.aliases })),
)

function slugForIngredientName(name: string): string | undefined {
  return ingredientSlugByName.get(normalizeIngredientName(name))
}
const recipePhoto = resolveRecipePhoto(recipe?.photo, recipe?.category, recipe?.slug)
const recipeImage = recipePhoto ? await getImage({ src: recipePhoto }) : null
const recipeImageUrl = recipeImage ? new URL(recipeImage.src, Astro.site).toString() : undefined

type QuantityValue =
  | { type: 'text'; value: string }
  | { type: 'decimal'; value: number }
  | { type: 'fraction'; num: number; den: number }

function formatQuantityValue(value: QuantityValue): { amount: string; numeric: number } {
  if (value.type === 'decimal') return { amount: String(value.value), numeric: value.value }
  if (value.type === 'fraction') {
    return {
      amount: `${value.num}/${value.den}`,
      numeric: value.den === 0 ? 0 : value.num / value.den,
    }
  }
  const numeric = Number.parseFloat(value.value)
  return { amount: value.value, numeric: Number.isFinite(numeric) ? numeric : 0 }
}

function formatQuantity(quantity?: FixedValue | Range): { amount: string; numeric: number } {
  if (!quantity) return { amount: '', numeric: 0 }
  if (quantity.type === 'fixed') return formatQuantityValue(quantity.value)
  const min = formatQuantityValue(quantity.min)
  const max = formatQuantityValue(quantity.max)
  return { amount: `${min.amount}-${max.amount}`, numeric: min.numeric }
}

function parseDurationMinutes(value: string): number | null {
  const normalized = value.trim().toLowerCase()
  if (!normalized) return null
  const match = normalized.match(/^(\d+(?:\.\d+)?)\s*(minute|minutes|min|mins|hour|hours|hr|hrs)$/)
  if (!match) return null
  const amount = Number.parseFloat(match[1])
  if (!Number.isFinite(amount) || amount <= 0) return null
  return ['hour', 'hours', 'hr', 'hrs'].includes(match[2]) ? amount * 60 : amount
}

function minutesToIso(minutes: number): string {
  const h = Math.floor(minutes / 60)
  const m = Math.round(minutes % 60)
  if (h > 0 && m > 0) return `PT${h}H${m}M`
  if (h > 0) return `PT${h}H`
  return `PT${m}M`
}

function toIsoDuration(value: string): string | undefined {
  const minutes = parseDurationMinutes(value)
  return minutes !== null ? minutesToIso(minutes) : undefined
}

function sumDurationsIso(a: string, b: string): string | undefined {
  const ma = parseDurationMinutes(a)
  const mb = parseDurationMinutes(b)
  return ma !== null && mb !== null ? minutesToIso(ma + mb) : undefined
}

function timerSeconds(amount: number, unit: string): number {
  const normalized = unit.toLowerCase().trim()
  if (['s', 'sec', 'secs', 'second', 'seconds'].includes(normalized)) return amount
  if (['m', 'min', 'mins', 'minute', 'minutes'].includes(normalized)) return amount * 60
  if (['h', 'hr', 'hrs', 'hour', 'hours'].includes(normalized)) return amount * 3600
  return amount
}

function quantityForIngredientItem(
  ingredient: Ingredient,
  partIndex?: number,
): { amount: string; numeric: number; units: string } {
  const part = partIndex === undefined ? undefined : (ingredient.quantityParts?.[partIndex] as QuantityPart | undefined)
  const source = part?.value ?? ingredient.quantity
  const units = part?.unit ?? ingredient.unit ?? ''
  const base = formatQuantity(source)
  return { amount: base.amount, numeric: base.numeric, units }
}

function renderItem(item: Item): string {
  if (item.type === 'text') return escapeHtml(item.value)

  if (item.type === 'ingredient') {
    const ingredient = recipe?.ingredients[item.index]
    if (!ingredient) return ''
    const { amount, numeric, units } = quantityForIngredientItem(ingredient, item.quantityPartIndex)
    const hasQty = !!amount
    const qtyPrefix = hasQty ? `${escapeHtml(amount)}${units ? ` ${escapeHtml(units)}` : ''} ` : ''
    const name = escapeHtml(item.displayName || ingredient.name)
    const prep = ingredient.preparation
      ? ` <span class="step-preparation">(${escapeHtml(ingredient.preparation)})</span>`
      : ''
    const attrs =
      hasQty && numeric > 0 ? ` data-quantity="${numeric}" data-units="${escapeHtml(units)}" data-name="${name}"` : ''
    return `<strong class="step-ingredient"${attrs}>${qtyPrefix}${name}</strong>${prep}`
  }

  if (item.type === 'cookware') {
    const cookware = recipe?.cookware[item.index]
    if (!cookware) return ''
    return `<em class="step-cookware">${escapeHtml(cookware.name)}</em>`
  }

  const timer = recipe?.timers[item.index]
  if (!timer) return ''
  const { amount } = formatQuantity(timer.duration)
  return `<span class="step-timer-ref">${escapeHtml(amount)} ${escapeHtml(timer.unit)}</span>`
}

function textForItem(item: Item): string {
  if (item.type === 'text') return item.value

  if (item.type === 'ingredient') {
    const ingredient = recipe?.ingredients[item.index]
    if (!ingredient) return ''
    const { amount, units } = quantityForIngredientItem(ingredient, item.quantityPartIndex)
    const prefix = amount ? `${amount}${units ? ` ${units}` : ''} ` : ''
    return `${prefix}${item.displayName || ingredient.name}`
  }

  if (item.type === 'cookware') {
    const cookware = recipe?.cookware[item.index]
    return cookware?.name ?? ''
  }

  const timer = recipe?.timers[item.index]
  if (!timer) return ''
  const { amount } = formatQuantity(timer.duration)
  return `${amount} ${timer.unit}`
}

function formatIngredientText(ingredient: Ingredient): string {
  const { amount, units } = quantityForIngredientItem(ingredient)
  const prefix = amount ? `${amount}${units ? ` ${units}` : ''} ` : ''
  const prep = ingredient.preparation ? ` (${ingredient.preparation})` : ''
  return `${prefix}${ingredient.name}${prep}`.trim()
}

const recipeSchema = recipe
  ? {
      '@context': 'https://schema.org',
      '@type': 'Recipe',
      name: recipe.title,
      description: recipe.description || undefined,
      recipeCategory: recipe.category || undefined,
      recipeCuisine: recipe.cuisine || undefined,
      image: recipeImageUrl,
      url: new URL(`/recipes/${recipe.slug}`, Astro.site).toString(),
      prepTime: toIsoDuration(recipe.prepTime),
      cookTime: toIsoDuration(recipe.cookTime),
      totalTime: sumDurationsIso(recipe.prepTime, recipe.cookTime),
      recipeYield: recipe.servings ? `${recipe.servings}` : undefined,
      recipeIngredient: recipe.ingredients.map(formatIngredientText),
      recipeInstructions: recipe.steps.map((step, index) => ({
        '@type': 'HowToStep',
        name: `Step ${index + 1}`,
        text: step.items.map(textForItem).join('').replaceAll(/\s+/g, ' ').trim(),
        url: new URL(`/recipes/${recipe.slug}#step-${index + 1}`, Astro.site).toString(),
      })),
    }
  : null
const recipeSchemaJson = recipeSchema ? JSON.stringify(recipeSchema) : ''

let runningStepNumber = 0
const sectionViews = recipe?.sections.map((section, sectionIndex) => {
  const ingredientMap = new Map<number, { quantity: number; units: string }>()

  for (const step of section.steps) {
    for (const item of step.items) {
      if (item.type !== 'ingredient') continue
      const ingredient = recipe.ingredients[item.index]
      if (!ingredient) continue
      const parsed = quantityForIngredientItem(ingredient, item.quantityPartIndex)
      const current = ingredientMap.get(item.index)
      if (!current) {
        ingredientMap.set(item.index, { quantity: parsed.numeric, units: parsed.units })
      } else if (current.units === parsed.units) {
        current.quantity += parsed.numeric
      }
    }
  }

  return {
    id: `section-${sectionIndex + 1}`,
    name: section.name,
    ingredients: Array.from(ingredientMap.entries()).map(([index, value]) => ({
      index,
      quantity: value.quantity,
      units: value.units,
      ingredient: recipe.ingredients[index],
    })),
    steps: section.steps.map((step) => {
      runningStepNumber += 1
      return {
        number: runningStepNumber,
        step,
        timers: step.items.filter((item): item is TimerItem => item.type === 'timer'),
      }
    }),
  }
})
---

<RecipeLayout
  recipe={recipe}
  categories={categories}
  recipeSchemaJson={recipeSchemaJson}
  socialImage={recipeImage?.src}
>
  <div slot="sidebar" class="section-ingredients">
    <div class="servings-control" data-enhanced="false">
      <span class="servings-control__label">Serves</span>
      <button id="servings-decrease" class="servings-control__btn" aria-label="Decrease servings" disabled>−</button>
      <span
        id="servings-current"
        class="servings-control__count p-yield"
        aria-live="polite"
        data-base-servings={recipe?.servings}
      >
        {recipe?.servings}
      </span>
      <button id="servings-increase" class="servings-control__btn" aria-label="Increase servings" disabled>+</button>
      <span class="servings-control__divider" aria-hidden="true"></span>
      <button
        data-wake-lock-btn
        class="servings-control__btn servings-control__wake-lock"
        aria-label="Keep screen on"
        aria-pressed="false"
        hidden
      >
        <span data-eye="open" aria-hidden="true">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10 12a2 2 0 1 0 4 0a2 2 0 0 0 -4 0"/><path d="M21 12c-2.4 4 -5.4 6 -9 6c-3.6 0 -6.6 -2 -9 -6c2.4 -4 5.4 -6 9 -6c3.6 0 6.6 2 9 6"/></svg>
        </span>
        <span data-eye="slash" aria-hidden="true">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10.585 10.587a2 2 0 0 0 2.829 2.828"/><path d="M16.681 16.673a8.717 8.717 0 0 1 -4.681 1.327c-3.6 0 -6.6 -2 -9 -6c1.272 -2.12 2.712 -3.678 4.32 -4.674m2.86 -1.146a9.055 9.055 0 0 1 1.82 -.18c3.6 0 6.6 2 9 6c-.666 1.11 -1.379 2.067 -2.138 2.87"/><path d="M3 3l18 18"/></svg>
        </span>
      </button>
    </div>

    {sectionViews?.filter((section) => section.ingredients.length > 0).map((section) => (
      <section class="ingredients-section">
        {section.name && <h3 class="ingredients-section__title">{section.name}</h3>}
        <ul class="ingredients-list">
          {section.ingredients.map(({ ingredient, quantity, units }) => {
            const ingredientSlug = slugForIngredientName(ingredient.name)
            return (
            <li>
              <span class="ingredient__name">
                <span class="p-ingredient">
                  {ingredientSlug
                    ? <a href={`/ingredients/${ingredientSlug}`}>{ingredient.name}</a>
                    : ingredient.name}
                </span>
                {ingredient.preparation && <span class="ingredient__prep">{ingredient.preparation}</span>}
              </span>
              <span class="ingredient__amount">
                {quantity > 0 && (
                  <span class="js-scaled-amount" data-quantity={quantity} data-units={units}>
                    {quantity} {units}
                  </span>
                )}
              </span>
            </li>
            )
          })}
        </ul>
      </section>
    ))}
  </div>

  <div data-step-checklist class="e-instructions">
  {sectionViews?.map((section) => (
    <section class="cooklang-section" id={section.id}>
      {section.name && <h2 class="cooklang-section__title">{section.name}</h2>}
      <ol class="steps">
        {section.steps.map(({ number, step, timers }) => (
          <li class="step" id={`step-${number}`} data-checked="false">
            <button class="step__checkbox" aria-label={`Mark step ${number} complete`} aria-pressed="false">
              <span class="step__num">{number}</span>
              <span class="step__check">✓</span>
            </button>
            <div class="step__content">
              <p class="step__text" set:html={step.items.map(renderItem).join('')} />
              {timers.length > 0 && (
                <div class="step__timers">
                  {timers.map((timerItem, j) => {
                    const timer = recipe?.timers[timerItem.index]
                    if (!timer) return null
                    const { numeric } = formatQuantity(timer.duration)
                    return (
                    <step-timer
                      duration={timerSeconds(numeric, timer.unit)}
                      label={`Step ${number}`}
                      timer-id={`${recipe?.slug}-s${number}-t${j + 1}`}
                      recipe-name={recipe?.title}
                      recipe-url={`/recipes/${recipe?.slug}#step-${number}`}
                    />
                  )})}
                </div>
              )}
              {step.note && <p class="step__note">{step.note}</p>}
            </div>
          </li>
        ))}
      </ol>
    </section>
  ))}
  </div>
  <div class="checklist-reset no-print" hidden>
    <button class="checklist-reset__btn" id="checklist-reset">Reset steps</button>
  </div>
</RecipeLayout>

<style>
  .cooklang-section + .cooklang-section {
    margin-top: 2rem;
  }
  .cooklang-section__title {
    font-family: var(--font-serif);
    font-size: 1.5rem;
    margin: 0 0 0.5rem;
    line-height: 1.25;
    font-family: var(--font-serif);
    color: var(--color-ink);
  }

  .section-ingredients {
    display: grid;
    gap: 2rem;
  }
  .servings-control {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 0.25rem;
  }
  .servings-control[data-enhanced="false"] .servings-control__btn {
    display: none;
  }
  .servings-control__label {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-subtle);
  }
  .servings-control__btn {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    border: 1px solid var(--color-edge);
    background: #fff;
    color: var(--color-interactive);
    cursor: pointer;
    font-size: 1.1rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    transition: border-color 0.15s, background 0.15s;
  }
  .servings-control__btn:disabled {
    border: 1px solid var(--color-edge);
    color: var(--color-edge);
    cursor: auto;
  }
  .servings-control__btn:hover:not(:disabled) {
    border-color: var(--color-interactive);
    background: var(--color-tint);
  }
  .servings-control__divider {
    width: 1px;
    height: 1.5rem;
    background: var(--color-edge);
    flex-shrink: 0;
  }
  .servings-control__wake-lock [data-eye] { display: inline-flex; align-items: center; }
  .servings-control__wake-lock [data-eye="open"] { display: none; }
  .servings-control__wake-lock[aria-pressed="true"] { border-color: var(--color-interactive); color: var(--color-interactive); }
  .servings-control__wake-lock[aria-pressed="true"] [data-eye="open"] { display: inline-flex; align-items: center; }
  .servings-control__wake-lock[aria-pressed="true"] [data-eye="slash"] { display: none; }
  .servings-control__count {
    font-family: var(--font-serif);
    font-size: 1.125rem;
    min-width: 2ch;
    text-align: center;
  }

  .ingredients-section__title {
    margin: 0 0 0.5rem;
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-subtle);
  }
  .ingredients-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .ingredients-list li {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.75rem;
    padding: 0.35rem 0;
    border-bottom: 1px solid var(--color-edge);
    font-size: 0.9rem;
  }
  .ingredients-list li:last-child {
    border-bottom: none;
  }
  .ingredient__name {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.15rem;
  }
  .ingredient__prep {
    color: var(--color-subtle);
    font-style: italic;
    font-size: 0.82em;
    line-height: 1.2;
  }
  .ingredient__amount {
    color: var(--color-highlight);
    font-weight: 600;
    white-space: nowrap;
  }

  .steps {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .step {
    display: grid;
    grid-template-columns: 2.75rem 1fr;
    gap: 1rem;
    padding: 1.25rem 0;
    border-bottom: 1px solid var(--color-edge);
    transition: opacity 0.2s;
  }
  .step:last-child { border-bottom: none; }
  .step[data-checked="true"] { opacity: 0.55; }

  .step__checkbox {
    all: unset;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 50%;
    border: 1.5px solid var(--color-edge);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    flex-shrink: 0;
    transition: border-color 0.15s, background 0.15s;
    margin-top: 0.15rem;
  }
  .step__checkbox:hover {
    border-color: var(--color-interactive);
    background: var(--color-tint);
  }
  .step__checkbox:active {
    background: var(--color-tint);
    border-color: var(--color-interactive);
  }
  .step[data-checked="true"] .step__checkbox {
    background: var(--color-interactive);
    border-color: var(--color-interactive);
  }

  .step__num {
    font-family: var(--font-serif);
    font-size: 1.25rem;
    color: var(--color-interactive);
    font-style: italic;
    line-height: 1;
  }
  .step__check {
    display: none;
    font-size: 0.875rem;
    color: #fff;
    font-style: normal;
  }
  .step[data-checked="true"] .step__num { display: none; }
  .step[data-checked="true"] .step__check { display: block; }
  .step__content { padding-top: 0.1rem; }
  .step__text {
    margin: 0 0 0.75rem;
    font-size: 1rem;
    line-height: 1.7;
  }
  .step__text :global(.step-ingredient) {
    font-style: normal;
    font-weight: 600;
    color: var(--color-ink);
    background: var(--color-tint);
    padding: 0.1em 0.25em;
    border-radius: 2px;
  }
  .step__text :global(.step-preparation) {
    color: var(--color-subtle);
    font-style: italic;
    font-weight: 400;
  }
  .step__text :global(.step-cookware) {
    font-style: italic;
    color: var(--color-subtle);
  }
  .step__timers {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .step__note {
    margin: 0.625rem 0 0;
    font-family: var(--font-serif);
    font-size: 0.9375rem;
    font-style: italic;
    color: var(--color-subtle);
    line-height: 1.55;
  }
  .step__text :global(.step-timer-ref) {
    font-weight: 400;
    color: var(--color-interactive);
  }

  @keyframes step-check-pop {
    0%   { transform: scale(1); }
    40%  { transform: scale(1.045); }
    70%  { transform: scale(0.975); }
    100% { transform: scale(1); }
  }
  .step--pop .step__checkbox {
    animation: step-check-pop 0.35s cubic-bezier(0.34, 1.56, 0.64, 1) both;
  }
  .step__checkbox:active {
    transform: scale(0.9);
    transition: transform 0.08s ease;
  }

  @media (prefers-reduced-motion: reduce) {
    .step--pop .step__checkbox { animation: none; }
    .step__checkbox:active { transform: none; }
  }

  .step-hint {
    margin: -0.25rem 0 1rem 3.75rem;
    font-size: 0.8125rem;
    font-style: italic;
    color: var(--color-subtle);
    transition: opacity 0.3s;
  }
  .step-hint.dismissed { opacity: 0; pointer-events: none; }

  .checklist-reset {
    padding: 1.5rem 0 0;
    border-top: 1px solid var(--color-edge);
    margin-top: 0.5rem;
  }
  .checklist-reset__btn {
    all: unset;
    cursor: pointer;
    font-size: 0.8125rem;
    color: var(--color-subtle);
    text-decoration: underline;
    text-underline-offset: 2px;
    transition: color 0.15s;
  }
  .checklist-reset__btn:hover { color: var(--color-interactive); }
</style>

<script>
  function checklistStorageKey(): string {
    return `cookbook-checklist:${location.pathname}`;
  }

  function restoreChecklistState(root: Element): void {
    try {
      const raw = localStorage.getItem(checklistStorageKey());
      if (!raw) return;
      const parsed = JSON.parse(raw);
      const TTL = 24 * 60 * 60 * 1000;
      if (!parsed.savedAt || Date.now() - parsed.savedAt > TTL) {
        localStorage.removeItem(checklistStorageKey());
        return;
      }
      const state: boolean[] = parsed.state;
      const steps = root.querySelectorAll<HTMLElement>('li.step');
      steps.forEach((li, i) => {
        if (state[i] !== undefined) {
          li.setAttribute('data-checked', String(state[i]));
          syncCheckboxPressed(li);
        }
      });
    } catch (_) {}
  }

  function syncCheckboxPressed(li: HTMLElement): void {
    const btn = li.querySelector<HTMLElement>('.step__checkbox');
    if (btn) btn.setAttribute('aria-pressed', li.getAttribute('data-checked') === 'true' ? 'true' : 'false');
  }

  function saveChecklistState(root: Element): void {
    const steps = root.querySelectorAll<HTMLElement>('li.step');
    const state = Array.from(steps).map((li) => li.getAttribute('data-checked') === 'true');
    try {
      localStorage.setItem(checklistStorageKey(), JSON.stringify({ state, savedAt: Date.now() }));
    } catch (_) {}
  }

  function fmtQty(n: number): string {
    if (n === Math.floor(n)) return String(n);
    const fracs: [number, string][] = [[0.25,'¼'],[0.5,'½'],[0.75,'¾'],[0.33,'⅓'],[0.67,'⅔']];
    const whole = Math.floor(n);
    const frac = n - whole;
    const match = fracs.find(([v]) => Math.abs(v - frac) < 0.05);
    if (match) return (whole > 0 ? whole + ' ' : '') + match[1];
    return n.toFixed(1).replace(/\.0$/, '');
  }

  function applyServingsScale({ current, base }: { current: number; base: number }): void {
    document.querySelectorAll<HTMLElement>('.step-ingredient[data-quantity]').forEach(el => {
      const qty = parseFloat(el.dataset.quantity!);
      if (!qty) return;
      const units = el.dataset.units ?? '';
      const name = el.dataset.name ?? '';
      const scaled = qty * (current / base);
      el.textContent = `${fmtQty(scaled)}${units ? ' ' + units : ''} ${name}`;
    });

    document.querySelectorAll<HTMLElement>('.js-scaled-amount[data-quantity]').forEach(el => {
      const qty = parseFloat(el.dataset.quantity!);
      if (!qty) return;
      const units = el.dataset.units ?? '';
      const scaled = qty * (current / base);
      el.textContent = `${fmtQty(scaled)}${units ? ' ' + units : ''}`;
    });
  }

  document.addEventListener('servings-change', (e: Event) => {
    applyServingsScale((e as CustomEvent).detail as { current: number; base: number });
  });

  function initPage(): void {
    const checklistRoot = document.querySelector<HTMLElement>('[data-step-checklist]');
    const resetWrap = document.querySelector<HTMLElement>('.checklist-reset');
    const resetBtn = document.getElementById('checklist-reset');
    const stepHint = document.querySelector<HTMLElement>('.step-hint');

    function updateResetVisibility(): void {
      if (!checklistRoot || !resetWrap) return;
      const anyChecked = checklistRoot.querySelector('li.step[data-checked="true"]') !== null;
      resetWrap.hidden = !anyChecked;
      if (anyChecked && stepHint) stepHint.classList.add('dismissed');
    }

    if (checklistRoot && !checklistRoot.dataset.initialized) {
      checklistRoot.dataset.initialized = 'true';
      restoreChecklistState(checklistRoot);
      updateResetVisibility();

      checklistRoot.addEventListener('click', (e: Event) => {
        const btn = (e.target as Element).closest('.step__checkbox');
        if (!btn) return;

        const li = btn.closest('li.step');
        if (!li) return;

        const checked = li.getAttribute('data-checked') === 'true';
        li.setAttribute('data-checked', String(!checked));
        syncCheckboxPressed(li as HTMLElement);
        saveChecklistState(checklistRoot);
        updateResetVisibility();

        if (!checked) {
          li.classList.remove('step--pop');
          void (li as HTMLElement).offsetWidth;
          li.classList.add('step--pop');
          li.addEventListener('animationend', () => li.classList.remove('step--pop'), { once: true });
        }
      });

      resetBtn?.addEventListener('click', () => {
        checklistRoot.querySelectorAll<HTMLElement>('li.step').forEach(li => {
          li.setAttribute('data-checked', 'false');
          syncCheckboxPressed(li);
        });
        try { localStorage.removeItem(checklistStorageKey()); } catch (_) {}
        updateResetVisibility();
      });
    }

    const countEl = document.getElementById('servings-current');
    const dec = document.getElementById('servings-decrease');
    const inc = document.getElementById('servings-increase');
    const servingsControl = document.querySelector<HTMLElement>('.servings-control');

    if (countEl && dec && inc && servingsControl && !servingsControl.dataset.initialized) {
      servingsControl.dataset.initialized = 'true';
      const servingsStorageKey = `cookbook-servings:${location.pathname}`;
      const base = parseFloat(countEl.dataset.baseServings || '4');
      let current = base;

      try {
        const saved = localStorage.getItem(servingsStorageKey);
        const parsed = saved ? Number.parseInt(saved, 10) : NaN;
        if (Number.isFinite(parsed) && parsed >= 1) current = parsed;
      } catch (_) {}

      const emit = () => {
        countEl.textContent = String(current);
        dec.toggleAttribute('disabled', current <= 1);
        try {
          localStorage.setItem(servingsStorageKey, String(current));
        } catch (_) {}
        document.dispatchEvent(new CustomEvent('servings-change', {
          detail: { current, base },
        }));
      };

      servingsControl.dataset.enhanced = 'true';
      dec.removeAttribute('disabled');
      inc.removeAttribute('disabled');

      dec.addEventListener('click', () => {
        if (current <= 1) return;
        current -= 1;
        emit();
      });

      inc.addEventListener('click', () => {
        current += 1;
        emit();
      });

      emit();
    }
  }

  document.addEventListener('astro:page-load', initPage);
  initPage();
</script>
