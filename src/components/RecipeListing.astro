---
import type { ParsedRecipe } from '../lib/cooklang'
import { pluralize } from '../lib/pluralize'
import RecipeCard from './RecipeCard.astro'
import RecipePagination from './RecipePagination.astro'

interface Props {
  heading: string
  totalRecipes: number
  visibleRecipes: ParsedRecipe[]
  currentPage: number
  totalPages: number
  basePath?: string
  searchIndex: string
}

const { heading, totalRecipes, visibleRecipes, currentPage, totalPages, basePath, searchIndex } = Astro.props
---

<main class="listing">
  <div class="listing__header">
    <h1>{heading}</h1>
    <p>{pluralize(totalRecipes, 'recipe')}</p>
  </div>
  <recipe-search target="recipes-static-content"></recipe-search>
  <div class="listing__items" id="recipes-static-content">
    <div class="grid">
      {visibleRecipes.map((recipe) => <RecipeCard recipe={recipe} />)}
    </div>
    <RecipePagination currentPage={currentPage} totalPages={totalPages} basePath={basePath} />
  </div>
</main>

<script is:inline define:vars={{ searchIndex }}>
  window.__SEARCH_INDEX__ = JSON.parse(searchIndex)
</script>

<script>
  import '../web-components/recipe-search'
</script>

<style>
  .listing {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 3rem 1.5rem 4rem;
  }
  .listing__header {
    margin-bottom: 3rem;
    border-bottom: 1px solid var(--color-edge);
    padding-bottom: 1.5rem;
  }
  .listing__header h1 {
    font-size: clamp(2.25rem, 4.5vw, 3.5rem);
    margin: 0 0 0.375rem;
    line-height: 1.1;
  }
  .listing__header p {
    color: var(--color-subtle);
    font-size: 0.8125rem;
    margin: 0;
  }
  .listing__items {
    display: flex;
    flex-direction: column;
    gap: 3rem;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 1.75rem;
  }
</style>
