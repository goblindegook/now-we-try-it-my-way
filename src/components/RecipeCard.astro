---
import { Image } from 'astro:assets'
import type { RecipeMeta } from '../lib/cooklang'
import { cuisineToFlag } from '../lib/cuisine'
import { resolveRecipePhoto } from '../lib/recipe-images'
import '../styles/recipe-card.css'

interface Props {
  recipe: RecipeMeta
}
const { recipe } = Astro.props
const href = `/recipes/${recipe.slug}`
const recipePhoto = resolveRecipePhoto(recipe.photo, recipe.category, recipe.slug)
const cuisineFlag = cuisineToFlag(recipe.cuisine)
---

<a href={href} class="recipe-card">
  <div class="recipe-card__image-wrap">
    {recipePhoto
      ? <Image src={recipePhoto} alt={recipe.title} class="recipe-card__image" loading="lazy" />
      : <div class="recipe-card__placeholder" aria-hidden="true" />
    }
  </div>
  <div class="recipe-card__body">
    <div class="recipe-card__top">
      <p class="recipe-card__category">{recipe.category}</p>
      {cuisineFlag && <span class="recipe-card__flag">{cuisineFlag}</span>}
    </div>
    <h2 class="recipe-card__title">{recipe.title}</h2>
    <div class="recipe-card__meta">
      {recipe.prepTime && <span>Prep: {recipe.prepTime}</span>}
      {recipe.cookTime && <span>Cook: {recipe.cookTime}</span>}
    </div>
  </div>
</a>
