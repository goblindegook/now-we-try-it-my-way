---
import IngredientCard from './IngredientCard.astro'
import RecipePagination from './RecipePagination.astro'

interface Props {
  visibleIngredients: { slug: string; name: string }[]
  currentPage: number
  totalPages: number
  searchIndex: string
}

const { visibleIngredients, currentPage, totalPages, searchIndex } = Astro.props
---

<main class="listing">
  <div class="listing__header">
    <h1>All Ingredients</h1>
  </div>
  <site-search target="ingredients-static-content"></site-search>
  <div class="listing__items" id="ingredients-static-content">
    <div class="grid">
      {visibleIngredients.map((ingredient) => <IngredientCard slug={ingredient.slug} name={ingredient.name} />)}
    </div>
    <RecipePagination currentPage={currentPage} totalPages={totalPages} basePath="/ingredients" label="Ingredient pages" />
  </div>
</main>

<script is:inline define:vars={{ searchIndex }}>
  window.__SEARCH_INDEX__ = JSON.parse(searchIndex)
</script>

<script>
  import '../web-components/site-search'
</script>

<style>
  .listing {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 3rem 1.5rem 4rem;
  }
  .listing__header {
    margin-bottom: 3rem;
    border-bottom: 1px solid var(--color-edge);
    padding-bottom: 1.5rem;
  }
  .listing__header h1 {
    font-size: clamp(2.25rem, 4.5vw, 3.5rem);
    margin: 0 0 0.375rem;
    line-height: 1.1;
  }
  .listing__items {
    display: flex;
    flex-direction: column;
    gap: 3rem;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 1.75rem;
  }
</style>
