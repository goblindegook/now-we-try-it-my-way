---
interface Props {
  categories: string[]
  current?: string
}
const { categories, current } = Astro.props
---

<nav class="site-navigation">
  <div class="site-navigation__inner">
    <a href="/" class:list={['site-navigation__logo', { active: !current }]}>
      Now We Try It My Way
    </a>
    <ul class="site-navigation__list">
      {categories.map(cat => (
        <li>
          <a
            href={`/${cat.toLowerCase()}`}
            class:list={['site-navigation__link', { active: current === cat }]}
          >
            {cat}
          </a>
        </li>
      ))}
    </ul>
  </div>
</nav>

<style>
  .site-navigation {
    background: var(--color-chrome-bg);
    position: relative;
    padding-top: env(safe-area-inset-top);
  }
  .site-navigation__inner {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 0 1rem;
    display: flex;
    align-items: baseline;
    gap: 2rem;
    height: 56px;
  }
  .site-navigation__logo {
    font-family: var(--font-serif);
    font-size: 1.5rem;
    font-weight: 400;
    font-style: italic;
    white-space: nowrap;
    color: var(--color-accent);
    padding: 0.55rem 0;

    @media (max-width: 700px) {
      font-size: clamp(1.5rem, 7vw, 3rem);
      max-width: 100%;
      overflow: hidden;
      text-overflow: ellipsis;
    }
  }
  .site-navigation__logo:hover {
    color: var(--color-chrome-fg);
  }
  .site-navigation__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    align-items: baseline;
    align-self: auto;
    gap: 1.5rem;
    overflow-x: auto;
    scrollbar-width: none;
    -ms-overflow-style: none;
    /* Fade-out shadow at right edge hints at hidden overflow */
    mask-image: linear-gradient(to right, black calc(100% - 2.5rem), transparent 100%);

    @media (max-width: 700px) {
      justify-content: space-around;
    }
  }
  .site-navigation__list::-webkit-scrollbar { display: none; }
  /* Only apply fade when overflowing */
  .site-navigation__list:not(.overflows) {
    mask-image: none;
  }
  /* Remove fade when fully scrolled to the end */
  .site-navigation__list.scrolled-end {
    mask-image: none;
  }
  .site-navigation__list li {
    display: flex;
    align-items: baseline;
  }
  .site-navigation__link {
    font-size: 0.875rem;
    font-weight: 400;
    color: var(--color-chrome-fg);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    padding: 0 0 0.6rem 0;
    border-bottom: 4px solid transparent;
    transition: color 0.15s, border-color 0.15s;
  }
  .site-navigation__link:hover,
  .site-navigation__link.active {
    color: var(--color-accent);
    border-bottom-color: var(--color-accent);
  }
  @media (max-width: 700px) {
    .site-navigation__inner {
      flex-direction: column;
      align-items: center;
      height: auto;
      padding-top: 1.25rem;
      padding-bottom: 0;
      gap: 0.25rem;
    }
    .site-navigation__logo {
      align-self: center;
      padding-top: 0;
      padding-bottom: 0.75rem;
    }
    .site-navigation__list {
      align-self: stretch;
      gap: 1.25rem;
    }
    .site-navigation__link {
      padding: 0.625rem 0;
    }
  }
</style>

<script>
  const list = document.querySelector<HTMLElement>('.site-navigation__list')
  if (list) {
    const update = () => {
      const overflows = list.scrollWidth > list.clientWidth
      list.classList.toggle('overflows', overflows)
      const atEnd = list.scrollLeft + list.clientWidth >= list.scrollWidth - 2
      list.classList.toggle('scrolled-end', atEnd)
    }
    update()
    list.addEventListener('scroll', update, { passive: true })
    window.addEventListener('resize', update, { passive: true })
  }
</script>
